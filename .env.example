# Required for persistent production data. Leave unset to use the non-persistent demo adapter.
DATABASE_URL="postgresql://iec:change-me@127.0.0.1:55432/iec_expobot?schema=public"
# Use "database" to fail fast instead of using demo reads when PostgreSQL is offline.
EXHIBITION_DATA_MODE="auto"

# Optional: enables live exhibition research. Without it, the verified demo research catalog is used.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

NODE_ENV="development"
