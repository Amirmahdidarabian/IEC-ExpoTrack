generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum Permission {
  VIEW_EXHIBITIONS
  CREATE_EXHIBITIONS
  UPDATE_EXHIBITIONS
  DELETE_EXHIBITIONS
  VIEW_ADMIN_DASHBOARD
  MANAGE_USERS
  VIEW_AUDIT_LOGS
  VIEW_COMPANIES
  CREATE_COMPANIES
  UPDATE_COMPANIES
  DELETE_COMPANIES
  IMPORT_COMPANIES
  VIEW_MEDIA
  CREATE_MEDIA
  UPDATE_MEDIA
  DELETE_MEDIA
  IMPORT_MEDIA
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_EXHIBITION
  UPDATE_EXHIBITION
  DELETE_EXHIBITION
  PRE_EVENT_EMAIL_MARKED_SENT
  PRE_EVENT_EMAIL_MARKED_UNSENT
  POST_EVENT_EMAIL_MARKED_SENT
  POST_EVENT_EMAIL_MARKED_UNSENT
  CREATE_USER
  UPDATE_USER
  DISABLE_USER
  ENABLE_USER
  CHANGE_USER_PERMISSIONS
  RESET_USER_PASSWORD
  CHANGE_OWN_PASSWORD
  CHANGE_USERNAME
  EXPORT_DATA
  IMPORT_DATA
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_DELETED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  COMPANY_EXHIBITION_LINKED
  COMPANY_EXHIBITION_UNLINKED
  COMPANY_CATEGORY_UPDATED
  COMPANY_TOPIC_UPDATED
  COMPANY_NOTE_CREATED
  COMPANY_NOTE_UPDATED
  COMPANY_NOTE_DELETED
  COMPANY_IMPORT_STARTED
  COMPANY_IMPORT_COMPLETED
  COMPANY_IMPORT_FAILED
  MEDIA_CREATED
  MEDIA_UPDATED
  MEDIA_DELETED
  MEDIA_CONTACT_CREATED
  MEDIA_CONTACT_UPDATED
  MEDIA_CONTACT_DELETED
  MEDIA_CLASSIFICATION_UPDATED
  MEDIA_NOTE_CREATED
  MEDIA_NOTE_UPDATED
  MEDIA_NOTE_DELETED
  MEDIA_IMPORT_STARTED
  MEDIA_IMPORT_COMPLETED
  MEDIA_IMPORT_FAILED
}

enum AuditEntityType {
  EXHIBITION
  USER
  AUTH
  SYSTEM
  COMPANY
  CONTACT
  COMPANY_IMPORT
  MEDIA
  MEDIA_CONTACT
  MEDIA_IMPORT
}

enum CompanySocialPlatform {
  LINKEDIN
  X
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  TELEGRAM
  OTHER
}

enum CompanyExhibitionRole {
  EXHIBITOR
  SPONSOR
  SPEAKER
  PARTNER
  VISITOR
  OTHER
  UNKNOWN
}

enum CompanyImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                   String             @id @default(cuid())
  username             String             @unique
  passwordHash         String
  role                 UserRole           @default(USER)
  isActive             Boolean            @default(true)
  mustChangePassword   Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lastLoginAt          DateTime?
  permissions          UserPermission[]
  sessions             Session[]
  auditLogs            AuditLog[]         @relation("AuditActor")
  createdExhibitions   Exhibition[]       @relation("ExhibitionCreatedBy")
  updatedExhibitions   Exhibition[]       @relation("ExhibitionUpdatedBy")
  preEmailExhibitions  Exhibition[]       @relation("ExhibitionPreEmailBy")
  postEmailExhibitions Exhibition[]       @relation("ExhibitionPostEmailBy")
  createdCompanies     Company[]          @relation("CompanyCreatedBy")
  companyNotes         CompanyNote[]      @relation("CompanyNoteAuthor")
  companyImportJobs    CompanyImportJob[] @relation("CompanyImportStartedBy")
  createdMedia         MediaOutlet[]      @relation("MediaCreatedBy")
  mediaNotes           MediaNote[]        @relation("MediaNoteAuthor")
  mediaImportJobs      MediaImportJob[]   @relation("MediaImportActor")

  @@index([isActive])
}

model UserPermission {
  userId     String
  permission Permission
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@index([permission])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SecurityRateLimit {
  id              String    @id @default(cuid())
  scope           String
  identifierHash  String
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([scope, identifierHash])
  @@index([updatedAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String?
  action      AuditAction
  entityType  AuditEntityType
  entityId    String?
  entityLabel String?
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())
  actor       User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
}

model Exhibition {
  id                     String               @id @default(cuid())
  slug                   String               @unique
  name                   String
  tagline                String               @default("")
  industry               String               @default("Energy")
  eventType              String               @default("International Exhibition")
  country                String
  countryCode            String?
  city                   String               @default("")
  venue                  String               @default("")
  address                String               @default("")
  startDate              DateTime
  endDate                DateTime?
  timezone               String               @default("UTC")
  organizer              String               @default("")
  website                String               @default("")
  description            String               @default("")
  aiReport               String               @default("")
  topics                 Json
  saved                  Boolean              @default(false)
  exhibitorList          Boolean              @default(false)
  exhibitorListWithLink  Boolean              @default(false)
  visitorMessaging       Boolean              @default(false)
  exhibitorListUrl       String               @default("")
  preEventEmailSent      Boolean              @default(false)
  preEventEmailSentAt    DateTime?
  preEventEmailSentById  String?
  postEventEmailSent     Boolean              @default(false)
  postEventEmailSentAt   DateTime?
  postEventEmailSentById String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  sources                Source[]
  categories             ExhibitionCategory[]
  topicLinks             ExhibitionTopic[]
  companies              CompanyExhibition[]
  createdBy              User?                @relation("ExhibitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?                @relation("ExhibitionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  preEventEmailSentBy    User?                @relation("ExhibitionPreEmailBy", fields: [preEventEmailSentById], references: [id], onDelete: SetNull)
  postEventEmailSentBy   User?                @relation("ExhibitionPostEmailBy", fields: [postEventEmailSentById], references: [id], onDelete: SetNull)

  @@index([startDate])
  @@index([country])
  @@index([industry])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdById])
  @@index([updatedById])
}

model IndustryCategory {
  id             String               @id @default(cuid())
  name           String
  normalizedName String               @unique
  slug           String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  exhibitions    ExhibitionCategory[]
  companies      CompanyCategory[]
  media          MediaCategory[]
}

model Topic {
  id             String            @id @default(cuid())
  name           String
  normalizedName String            @unique
  slug           String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  exhibitions    ExhibitionTopic[]
  companies      CompanyTopic[]
  media          MediaTopic[]
}

model ExhibitionCategory {
  exhibitionId String
  categoryId   String
  exhibition   Exhibition       @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  category     IndustryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([exhibitionId, categoryId])
  @@index([categoryId])
}

model ExhibitionTopic {
  exhibitionId String
  topicId      String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([exhibitionId, topicId])
  @@index([topicId])
}

model Source {
  id           String     @id @default(cuid())
  label        String
  url          String
  lastChecked  DateTime
  priority     Int        @default(5)
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
}

model Company {
  id             String              @id @default(cuid())
  name           String
  normalizedName String
  website        String?
  domain         String?
  countryCode    String?
  country        String?
  description    String?
  priorityScore  Int?
  saved          Boolean             @default(false)
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      User?               @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts       CompanyContact[]
  socialLinks    CompanySocialLink[]
  categories     CompanyCategory[]
  topics         CompanyTopic[]
  exhibitions    CompanyExhibition[]
  notes          CompanyNote[]

  @@index([name])
  @@index([normalizedName])
  @@index([domain])
  @@index([countryCode])
  @@index([priorityScore])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdById])
}

model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String
  firstName   String?
  lastName    String?
  jobTitle    String?
  department  String?
  email       String?
  phone       String?
  whatsapp    String?
  linkedinUrl String?
  notes       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
}

model CompanySocialLink {
  id        String                @id @default(cuid())
  companyId String
  platform  CompanySocialPlatform
  url       String
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform, url])
  @@index([companyId])
}

model CompanyCategory {
  companyId  String
  categoryId String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   IndustryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([companyId, categoryId])
  @@index([categoryId])
}

model CompanyTopic {
  companyId String
  topicId   String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([companyId, topicId])
  @@index([topicId])
}

model CompanyExhibition {
  id           String                @id @default(cuid())
  companyId    String
  exhibitionId String
  role         CompanyExhibitionRole @default(UNKNOWN)
  hall         String?
  booth        String?
  sourceUrl    String?
  notes        String?
  createdAt    DateTime              @default(now())
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exhibition   Exhibition            @relation(fields: [exhibitionId], references: [id], onDelete: Restrict)

  @@unique([companyId, exhibitionId])
  @@index([exhibitionId])
  @@index([companyId, createdAt])
}

model CompanyNote {
  id          String   @id @default(cuid())
  companyId   String
  body        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("CompanyNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([createdById])
}

model CompanyImportJob {
  id               String              @id @default(cuid())
  fileName         String
  startedById      String?
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  status           CompanyImportStatus @default(PENDING)
  totalRows        Int                 @default(0)
  validRows        Int                 @default(0)
  createdCompanies Int                 @default(0)
  updatedCompanies Int                 @default(0)
  createdContacts  Int                 @default(0)
  duplicates       Int                 @default(0)
  failedRows       Int                 @default(0)
  errorSummary     Json?
  startedBy        User?               @relation("CompanyImportStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([status])
  @@index([startedById])
}

enum MediaContactMethod {
  EMAIL
  CONTACT_PAGE
  WEBSITE_FORM
  OTHER
}

enum MediaImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model MediaOutlet {
  id                  String              @id @default(cuid())
  name                String
  normalizedName      String
  identityKey         String?             @unique
  websiteUrl          String?
  domain              String?
  sourceCategoryRaw   String?
  countryCode         String?
  countryName         String?
  publicationScopeRaw String?
  description         String?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdBy           User?               @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts            MediaContact[]
  socialLinks         MediaSocialLink[]
  categories          MediaCategory[]
  topics              MediaTopic[]
  notes               MediaNote[]
  sources             MediaImportSource[]

  @@index([normalizedName])
  @@index([domain])
  @@index([countryCode])
  @@index([publicationScopeRaw])
  @@index([sourceCategoryRaw])
  @@index([createdAt])
  @@index([updatedAt])
}

model MediaContact {
  id             String             @id @default(cuid())
  mediaOutletId  String
  name           String?
  roleLabel      String?
  department     String?
  email          String?
  phone          String?
  linkedInUrl    String?
  contactPageUrl String?
  contactMethod  MediaContactMethod @default(OTHER)
  notes          String?
  isPrimary      Boolean            @default(false)
  position       Int                @default(0)
  sourceLabelRaw String?
  sourceValueRaw String?
  sourceSheet    String?
  sourceRow      Int?
  importKey      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  mediaOutlet    MediaOutlet        @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)

  @@unique([mediaOutletId, importKey])
  @@index([mediaOutletId, position])
  @@index([email])
}

model MediaSocialLink {
  id            String                @id @default(cuid())
  mediaOutletId String
  platform      CompanySocialPlatform
  url           String
  mediaOutlet   MediaOutlet           @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)

  @@unique([mediaOutletId, platform, url])
}

model MediaCategory {
  mediaOutletId String
  categoryId    String
  mediaOutlet   MediaOutlet      @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)
  category      IndustryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([mediaOutletId, categoryId])
  @@index([categoryId])
}

model MediaTopic {
  mediaOutletId String
  topicId       String
  mediaOutlet   MediaOutlet @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([mediaOutletId, topicId])
  @@index([topicId])
}

model MediaNote {
  id            String      @id @default(cuid())
  mediaOutletId String
  body          String
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  mediaOutlet   MediaOutlet @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)
  createdBy     User?       @relation("MediaNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([mediaOutletId, createdAt])
}

model MediaImportJob {
  id          String              @id @default(cuid())
  fileName    String
  fileHash    String
  startedById String?
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  status      MediaImportStatus   @default(PROCESSING)
  report      Json?
  startedBy   User?               @relation("MediaImportActor", fields: [startedById], references: [id], onDelete: SetNull)
  sources     MediaImportSource[]

  @@index([fileHash])
  @@index([startedAt])
}

model MediaImportSource {
  id            String         @id @default(cuid())
  mediaOutletId String
  importJobId   String
  sourceSheet   String
  sourceRow     Int
  rawValues     Json
  warnings      Json
  mediaOutlet   MediaOutlet    @relation(fields: [mediaOutletId], references: [id], onDelete: Cascade)
  importJob     MediaImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, sourceSheet, sourceRow])
  @@index([mediaOutletId])
}
